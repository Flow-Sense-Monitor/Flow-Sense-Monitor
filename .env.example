# Copie este arquivo para ".env" (na mesma pasta do docker-compose.yml) e troque os valores.
# O .env NÃO vai para o Git (está no .gitignore).

# ---------- Banco de dados ----------
DB_USER=flowsense
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-de-root

# ---------- Broker MQTT ----------
# O ESP32 e o backend precisam usar o MESMO broker.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
# Preencha se migrar para um broker com autenticação (ex.: HiveMQ Cloud, porta 8883 com TLS).
MQTT_USER=
MQTT_PASSWORD=
MQTT_TLS=false

# ---------- FlowSense ----------
# IDs aceitos (separados por vírgula). Deve bater com o DEVICE_ID do firmware.
FLOWSENSE_DISPOSITIVOS=esp32-01
# Chave para enviar comandos (relé, limites, intervalo). Gere uma longa, ex.: openssl rand -hex 24
FLOWSENSE_API_KEY=troque-por-uma-chave-longa
# Tarifa de energia em R$/kWh, usada no custo estimado.
FLOWSENSE_TARIFA_KWH=0.95
# Endereço pelo qual o dashboard é aberto no navegador (ex.: http://IP-DA-VM). Separe vários por vírgula.
FLOWSENSE_CORS_ORIGENS=http://localhost
# Dias de histórico e eventos guardados.
FLOWSENSE_RETENCAO_DIAS=90

# ---------- Rede ----------
# Porta pública do dashboard.
HTTP_PORT=80
# Porta do backend só dentro da VM (127.0.0.1), para testes com curl. Troque se a 8080 já estiver em uso.
BACKEND_PORT=8080
# Porta do MySQL só dentro da VM (127.0.0.1), para o MySQL Workbench via túnel SSH.
DB_PORT=3306
